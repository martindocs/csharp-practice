@model DrawingRegister.Web.Models.Drawing.Index.IndexDrawingViewModel
@using DrawingRegister.Data.Entities
@{
}

<form method="get" asp-action="Index" asp-controller="Drawing" id="drw-form">
    <div class="row">
        <div class="col-9 d-flex">
            <input type="text" class="form-control" placeholder="" aria-label="Recipient’s username" aria-describedby="button-addon2" name="query" value="@Model.Query">
            <button class="btn btn-outline-secondary" type="submit" id="button-addon2">Filter</button>
        </div>
        <div class="col-3 d-flex">
            <select 
                asp-for="Status"
                name="status" 
                asp-items="Html.GetEnumSelectList<Status>()" 
                    id="drw-status"
            >
                <option value="">All</option>
            </select>
            <select                 
                asp-for="ProjectId" 
                asp-items="@Model.Projects" 
                id="drw-project">
                <option value="">All</option>
            </select>     
        </div>

     </div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Document No.</th>
            <th scope="col">Status</th>
            <th scope="col">Project Name</th>
            <th scope="col" class="narrow-column"></th>
            <th scope="col" class="narrow-column"></th>
            <th scope="col" class="narrow-column"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var drw in Model.Drawings)
        {
            <tr>
                <td>@drw.Id</td>
                <td>@drw.Name</td>
                <td>@drw.DocumentNumber</td>
                <td>@drw.DrawingStatus</td>               
                <td>@drw.ProjectName</td>               
                <td>
                    <a 
                        asp-action="AddDrawing" 
                        asp-controller="Drawing"
                        class="btn btn-info"
                    >Add</a>
                </td>
                <td>
                    <a 
                        asp-action="EditDrawing" 
                        asp-controller="Drawing" 
                        asp-route-id="@drw.Id"
                       class="btn btn-primary">Edit</a>
                </td>
                <td>
                    <a class="btn btn-danger"
                       data-bs-toggle="modal" 
                        data-bs-target="#deleteDrawingleModal"
                        data-name="@drw.Name"
                        data-id="@drw.Id"
                    >Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>
<!-- Modal -->
<div class="modal fade" id="deleteDrawingleModal" tabindex="-1" aria-labelledby="deleteDrawingleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteDrawingleModalLabel">Confirm action</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want delete <span class="modal-msg" id="modal-msg"></span>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                 <form id="deleteDrawing" method="post">
                    @*
                        antiforgery token — without it ASP.NET Core will reject the POST 

                        How the token stops it: when the server renders your form, it embeds a random token (the hidden field from @Html.AntiForgeryToken()) and also sets a matching cookie. On POST, [ValidateAntiForgeryToken] checks that both are present and match. A malicious site can make your browser send the cookie, but it can’t read the token from your page, so its forged request fails with a 400.

                        The token only ensures the request came from your own page.
                        *@
                    @Html.AntiForgeryToken()
                    <button 
                        type="submit" 
                        class="btn btn-primary" 
                    >Delete drawing</button>
                 </form>
            </div>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById("deleteDrawingleModal");
    
    // show.bs.modal boostarp method will return the clicked element available as the "relatedTarget" prop 
    modal.addEventListener("show.bs.modal", function(e){
        
        // Need to set data prop on clicked "Delete" button
        const id = e.relatedTarget.dataset.id; // 
        const name = e.relatedTarget.dataset.name;

        const modalMessage = document.getElementById("modal-msg");
        const modalDeleteBtn = document.getElementById("deleteDrawing");

        modalMessage.textContent = name;
        // modal form has no asp-action, so it need to be added
        modalDeleteBtn.action = `/Drawing/DeleteDrawing/${id}`;
    });

    const form = document.querySelector("form");    
    const drwStatus = document.getElementById("drw-status");
    const drwProject = document.getElementById("drw-project");

    drwStatus.addEventListener("change", (e)=>{
        form.requestSubmit();
    });

    drwProject.addEventListener("change", (e)=>{
        form.requestSubmit();
    });

</script>
